# Copy this file to .env.local and fill in your real values from
# Supabase → Project Settings → API. .env.local is gitignored — never commit
# real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Also required for real account creation and the notification system's
# email dispatch (src/lib/notifications) — never NEXT_PUBLIC_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=

# The notification email pipeline (supabase/functions/send-notification-email,
# supabase/functions/send-test-email) reads its OWN secrets, set via the
# Supabase CLI — never put these in this file or any NEXT_PUBLIC_ variable:
#   supabase secrets set RESEND_API_KEY=... EMAIL_FROM="LUNEX TECH <notifications@your-verified-domain>" APP_URL=https://your-deployed-app
